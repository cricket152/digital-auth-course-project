{
  "name": "digital-auth-course-project",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "pki:setup": "node prototype/setup-pki.ts",
    "pki:status": "node prototype/set-status.ts",
    "start": "node prototype/main.ts",
    "demo": "npm run app",
    "demo:all": "node scripts/launch-demo.ts",
    "demo:server": "node app/server/main.ts --standalone",
    "demo:client": "node app/client/main.ts",
    "demo:prototype": "node prototype/demo.ts",
    "app": "node app/server/main.ts",
    "check": "tsc --noEmit",
    "test": "node --test tests/prototype.test.ts tests/lifecycle.test.ts tests/standalone.test.ts"
  },
  "dependencies": {
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "typescript": "6.0.3"
  }
}
